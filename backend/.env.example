# ═══════════════════════════════════════════════════════════════
# RepoMind Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── Application ───
APP_NAME=RepoMind
APP_VERSION=1.0.0
DEBUG=true

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── CORS (comma-separated list) ───
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Firebase (Server-Side Admin SDK) ───
# Get these from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_JSON=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ─── OpenAI ───
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Ollama (Optional — Local LLM Fallback) ───
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Embedding Model ───
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ─── Reranker Model ───
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Pipeline Defaults ───
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_TOP_K_RETRIEVAL=20
DEFAULT_TOP_K_RERANK=5
DEFAULT_STRATEGY=hybrid
DEFAULT_TEMPERATURE=0.1

# ─── Limits ───
MAX_REPO_COUNT=10
MAX_FILE_SIZE_BYTES=1048576
MAX_FILES_PER_REPO=500
MAX_ZIP_SIZE_BYTES=104857600
MAX_QUERY_LENGTH=1000

# ─── Paths ───
TEMP_DIR=/tmp/repomind
